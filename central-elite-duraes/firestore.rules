rules_version = '2';
// Regras de segurança da Central Elite & Durães.
// Copie TUDO e cole em Firebase > Firestore Database > Regras > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // E-mail do dono. Se mudar aqui, mude também em firebase-config.js.
    function donoEmail() { return 'duraesfotografiax@gmail.com'; }

    function logado() { return request.auth != null; }
    function ehDono() {
      return logado()
        && request.auth.token.email == donoEmail()
        && request.auth.token.email_verified == true;
    }
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function temPerfil() { return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
    function ativo() { return ehDono() || (temPerfil() && perfil().ativo == true); }
    function adm() { return ehDono() || (ativo() && perfil().papel == 'adm'); }
    function financeiro() { return adm() || (ativo() && perfil().financeiro == true); }

    // Contas da equipe
    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || adm());

      // Quem cria conta entra bloqueado, sem caixa, até um Adm aprovar.
      allow create: if logado() && request.auth.uid == uid && (
        ehDono() || (
          request.resource.data.keys().hasOnly(['nome', 'email', 'papel', 'financeiro', 'ativo', 'criado'])
          && request.resource.data.papel == 'equipe'
          && request.resource.data.financeiro == false
          && request.resource.data.ativo == false
          && request.resource.data.email == request.auth.token.email
        )
      );

      // A própria pessoa só muda o nome e a data do último acesso. O resto, só Adm.
      allow update: if adm() || (
        logado() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'visto', 'tokens', 'membro'])
      );
      allow delete: if adm();
    }

    // Produção, agenda e freelancers: toda a equipe aprovada
    match /tar/{id} { allow read, write: if ativo(); }
    match /freelas/{id} { allow read, write: if ativo(); }

    // Clientes (lojas) e conteúdos para postar
    match /lojas/{id} { allow read: if ativo(); allow write: if adm(); }
    match /posts/{id} { allow read, write: if ativo(); }

    // Configurações (pastas do Drive): todos leem, só Adm muda
    match /config/{id} { allow read: if ativo(); allow write: if adm(); }

    // Álbuns: o cliente abre pelo link (id secreto), sem login, e só pode mexer na própria seleção
    match /albuns/{id} {
      allow get: if true;
      allow list, create, delete: if ativo();
      allow update: if ativo() || (
        resource.data.status == 'aberto'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['selecionadas', 'obs', 'status', 'enviadoEm', 'atualizadoEm'])
        && request.resource.data.selecionadas is list
        && (resource.data.limite == 0 || request.resource.data.selecionadas.size() <= resource.data.limite)
        && request.resource.data.status in ['aberto', 'enviado']
        && (!('obs' in request.resource.data) || (request.resource.data.obs is string && request.resource.data.obs.size() <= 1000))
      );
    }

    // Envios: o cliente abre pelo link (id secreto), sem login; só consegue registrar que abriu/baixou
    match /envios/{id} {
      allow get: if true;
      allow list, create, delete: if ativo();
      allow update: if ativo() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aberturas', 'abertoEm', 'ultimoAcesso', 'baixados'])
        && (!('aberturas' in request.resource.data) || request.resource.data.aberturas is int)
        && (!('baixados' in request.resource.data) || request.resource.data.baixados is int)
        && (!('ultimoAcesso' in request.resource.data) || (request.resource.data.ultimoAcesso is string && request.resource.data.ultimoAcesso.size() < 40))
        && (!('abertoEm' in request.resource.data) || (request.resource.data.abertoEm is string && request.resource.data.abertoEm.size() < 40))
      );
    }

    // Dinheiro: só quem tem o caixa liberado
    match /lanc/{id} { allow read, write: if financeiro(); }
    match /valores/{id} { allow read, write: if financeiro(); }
    match /recibos/{id} { allow read, write: if financeiro(); }
    match /contratos/{id} { allow read, write: if financeiro(); }
    // Postagens: lista de páginas/Instagram e últimos posts (quem grava é o robô)
    match /metaPaginas/{id} { allow read: if ativo(); allow write: if false; }
    match /metaIG/{id} { allow read: if ativo(); allow write: if false; }
    // Tráfego pago: o robô grava; sócios leem; Adm só pode vincular a conta a uma loja
    match /anuncios/{id} { allow read: if financeiro(); allow update: if adm() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['loja']); }
    match /anunciosMeta/{id} { allow read: if financeiro(); }
    match /recibosCfg/{id} { allow read: if financeiro(); allow write: if adm(); }

    // Qualquer outra coisa: bloqueado
    // Controle do robô de notificações: o app só pode marcar "já avisei esta pessoa" (a própria),
    // para o robô não repetir um aviso que já apareceu na tela. Ninguém lê.
    match /avisos/{id} { allow create, update: if ativo() && id.matches('.*_' + request.auth.uid); }

    match /{outro=**} { allow read, write: if false; }
  }
}
